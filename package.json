{
  "name": "clipwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @clipwise/web --filter @clipwise/worker dev",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r test",
    "clipwise": "tsx apps/cli/src/index.ts",
    "make": "tsx apps/cli/src/index.ts make",
    "studio": "pnpm --filter @clipwise/video studio",
    "sample": "tsx packages/pipeline/scripts/render-sample.ts",
    "db:indexes": "tsx packages/db/scripts/indexes.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/db/scripts/seed.ts",
    "db:status": "tsx packages/db/scripts/status.ts",
    "user:admin": "tsx packages/db/scripts/user-admin.ts",
    "job:make": "tsx apps/worker/scripts/make.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
