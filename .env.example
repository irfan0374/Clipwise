# Clipwise settings. Copy to .env and fill in only what the feature you're working on needs.
# Never commit .env. Each group says which feature first uses it.

# ─── AI pipeline (prototype, in use now) ───────────────────────────────────────

# Gemini (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=
# Tried in order; each model has its own free daily quota (about 20 requests/day), so later ones take over.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — free plan
ELEVENLABS_API_KEY=
# Free plan: use a default voice, e.g. Liam TX3LPaxmHKxFdv7VOQHJ (library voices need a paid plan)
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL_DRAFT=eleven_flash_v2_5
ELEVENLABS_MODEL_FINAL=eleven_multilingual_v2
# Voiceovers that would go past this many credits this month are refused (free plan: 10000)
ELEVENLABS_MONTHLY_CREDITS=10000

# ─── App (Feature 3+) ──────────────────────────────────────────────────────────

# Public URL of the web app
APP_URL=http://localhost:3000

# ─── Database (Feature 2) ──────────────────────────────────────────────────────

# MongoDB Atlas connection string (free M0 cluster is enough for the beta).
# Database name goes before the "?": clipwise_dev locally, clipwise_staging, and clipwise in production
# (db:seed refuses to run against "clipwise").
MONGODB_URI=mongodb://<user>:<password>@<hosts>/clipwise_dev?ssl=true&authSource=admin&retryWrites=true&w=majority

# ─── Sign-in (Feature 5) ───────────────────────────────────────────────────────

# Email + password sign-in (Better Auth). Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Admins: create your account, then run `pnpm user:admin you@example.com` (no email-based promotion).

# ─── Worker, queue and storage (Step B) ────────────────────────────────────────

# Redis for BullMQ, budgets and live progress. Local: brew install redis && brew services start redis
REDIS_URL=redis://127.0.0.1:6379
# Free-tier guard: Gemini requests per day across all models (about 20 per model)
GEMINI_DAILY_REQUESTS=80

# File storage. "local" keeps files in .storage/ (dev). "s3" uses any S3-compatible bucket (R2, Backblaze B2).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# For STORAGE_DRIVER=s3 (chosen at deploy, step H):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Monitoring (Feature 15) ───────────────────────────────────────────────────

SENTRY_DSN=

# ─── v1: Instagram (Feature 18) and billing (Feature 19) ───────────────────────

META_APP_ID=
META_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
