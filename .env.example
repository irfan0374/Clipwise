# Gemini (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=
# Tried in order; each model has its own free daily quota (about 20 requests/day), so later ones take over.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys) — free plan
ELEVENLABS_API_KEY=
# Free plan: use a default voice, e.g. Liam TX3LPaxmHKxFdv7VOQHJ (library voices need a paid plan)
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_MODEL_DRAFT=eleven_flash_v2_5
ELEVENLABS_MODEL_FINAL=eleven_multilingual_v2
# Voiceovers that would go past this many credits this month are refused (free plan: 10000)
ELEVENLABS_MONTHLY_CREDITS=10000

